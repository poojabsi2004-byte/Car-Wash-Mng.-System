<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_carwash" model="ir.module.category">
        <field name="name">Car Wash</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_carwash" model="res.groups.privilege">
        <field name="name">Car Wash</field>
        <field name="category_id" ref="module_category_carwash"/>
        <field name="description">The person's job at the car wash - it decides what they see and can do in the Car Wash app.
The "Car Wash: ..." features (time slots, memberships, inspections...) aren't set per person: they are switched on / off for everyone in Car Wash > Configuration > Settings.</field>
    </record>

    <record id="group_carwash_user" model="res.groups">
        <field name="name">Front Desk</field>
        <field name="privilege_id" ref="res_groups_privilege_carwash"/>
        <field name="comment">Runs the counter: bookings, customers and vehicles, booking requests, invoices and customer payments, consumable requests. Sees every booking of the branch.</field>
        <!-- the front desk invoices bookings and takes the customer's payment (Invoicing: Billing) -->
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_carwash_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_carwash"/>
        <field name="comment">Runs the branch: everything of Front Desk, plus job cards and staff / QC assignment, Pay Staff / Pay QC, staff and attendance, purchases and their approval, configuration and settings.</field>
        <!-- managers maintain the service catalogue (Configuration > Services), which needs Products / Create -->
        <field name="implied_ids" eval="[(4, ref('group_carwash_user')), (4, ref('product.group_product_manager'))]"/>
        <!-- the administrator gets the Car Wash app (and its menu) as soon as it is installed -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Feature switches (Car Wash > Configuration > Settings). Technical groups implied by
         "Internal User" while the feature is on; switched on by default. -->
    <record id="group_carwash_time_slot" model="res.groups">
        <field name="name">Car Wash: Booking Time Slots</field>
    </record>
</odoo>
