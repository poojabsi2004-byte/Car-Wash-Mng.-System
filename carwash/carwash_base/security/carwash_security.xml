<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_carwash" model="ir.module.category">
        <field name="name">Car Wash</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_carwash" model="res.groups.privilege">
        <field name="name">Car Wash</field>
        <field name="category_id" ref="module_category_carwash"/>
    </record>

    <record id="group_carwash_user" model="res.groups">
        <field name="name">Front Desk</field>
        <field name="privilege_id" ref="res_groups_privilege_carwash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_carwash_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_carwash"/>
        <field name="implied_ids" eval="[(4, ref('group_carwash_user'))]"/>
    </record>
</odoo>
