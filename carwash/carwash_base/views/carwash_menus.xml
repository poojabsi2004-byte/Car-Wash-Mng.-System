<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Car Wash app menu layout (other carwash_* modules plug into these sections):
          Dashboard          (carwash_dashboard)
          Operations         Live Queue / All Bookings / New Booking
          Job Cards          (carwash_jobcard) Job Cards / Inspections
          Customers          Customers / Vehicles / Memberships (carwash_membership)
          Reporting          (carwash_jobcard) Wash Analysis / Employee Productivity / Revenue by Service
          Configuration      Services / Service Packages / Checklist Templates / Bays / Membership Plans
    -->
    <menuitem id="menu_carwash_root" name="Car Wash" sequence="10"/>

    <menuitem id="menu_carwash_operations" name="Operations" parent="menu_carwash_root" sequence="10"/>
    <menuitem id="menu_carwash_queue" name="Live Queue" parent="menu_carwash_operations"
              action="action_carwash_appointment_queue" sequence="10"/>
    <menuitem id="menu_carwash_appointment_all" name="All Bookings" parent="menu_carwash_operations"
              action="action_carwash_appointment_all" sequence="20"/>
    <menuitem id="menu_carwash_appointment_new" name="New Booking" parent="menu_carwash_operations"
              action="action_carwash_appointment_new" groups="group_carwash_user" sequence="30"/>

    <menuitem id="menu_carwash_customer_vehicle" name="Customers" parent="menu_carwash_root" sequence="30"/>
    <menuitem id="menu_carwash_customer" name="Customers" parent="menu_carwash_customer_vehicle"
              action="contacts.action_contacts" sequence="10"/>
    <menuitem id="menu_carwash_vehicle" name="Vehicles" parent="menu_carwash_customer_vehicle"
              action="action_carwash_vehicle" sequence="20"/>

    <menuitem id="menu_carwash_reporting" name="Reporting" parent="menu_carwash_root" sequence="80"/>

    <menuitem id="menu_carwash_config" name="Configuration" parent="menu_carwash_root"
              groups="group_carwash_manager" sequence="90"/>
    <menuitem id="menu_carwash_config_service" name="Services" parent="menu_carwash_config"
              action="action_carwash_service" sequence="10"/>
    <menuitem id="menu_carwash_bay" name="Bays" parent="menu_carwash_config"
              action="action_carwash_bay" sequence="40"/>
</odoo>
