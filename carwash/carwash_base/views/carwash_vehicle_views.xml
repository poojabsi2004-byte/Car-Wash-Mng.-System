<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carwash_vehicle_list" model="ir.ui.view">
        <field name="name">carwash.vehicle.list</field>
        <field name="model">carwash.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="license_plate"/>
                <field name="customer_id"/>
                <field name="make"/>
                <field name="vehicle_model"/>
                <field name="vehicle_type"/>
                <field name="visit_count"/>
                <field name="last_service_date"/>
            </list>
        </field>
    </record>

    <record id="view_carwash_vehicle_form" model="ir.ui.view">
        <field name="name">carwash.vehicle.form</field>
        <field name="model">carwash.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="appointment_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="license_plate"/>
                        <h1><field name="license_plate" placeholder="License Plate"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="vehicle_type"/>
                            <field name="color"/>
                        </group>
                        <group>
                            <field name="make"/>
                            <field name="vehicle_model"/>
                            <field name="year"/>
                            <field name="vin"/>
                        </group>
                    </group>
                    <group>
                        <field name="visit_count" readonly="1"/>
                        <field name="last_service_date" readonly="1"/>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_carwash_vehicle_search" model="ir.ui.view">
        <field name="name">carwash.vehicle.search</field>
        <field name="model">carwash.vehicle</field>
        <field name="arch" type="xml">
            <search string="Vehicles">
                <field name="license_plate"/>
                <field name="customer_id"/>
                <field name="vin"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Vehicle Type" name="group_type" context="{'group_by': 'vehicle_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_carwash_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">carwash.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
