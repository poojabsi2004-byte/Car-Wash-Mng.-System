<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_carwash_appointment_form" model="ir.ui.view">
        <field name="name">carwash.appointment.form</field>
        <field name="model">carwash.appointment</field>
        <field name="arch" type="xml">
            <form string="Booking" class="o_cw_form o_cw_appointment_form">
                <header>
                    <field name="all_services_done" invisible="1"/>
                    <field name="can_run_services" invisible="1"/>
                    <button name="action_confirm" type="object" string="Confirm" icon="fa-check"
                            class="btn-primary o_cw_btn_primary" invisible="state != 'draft'" groups="carwash_base.group_carwash_user"/>
                    <button name="action_arrive" type="object" string="Vehicle Arrived" icon="fa-sign-in"
                            class="btn-primary o_cw_btn_primary" invisible="state != 'confirmed'" groups="carwash_base.group_carwash_user"/>
                    <button name="action_start_service" type="object" string="Start Service" icon="fa-play"
                            class="btn-primary o_cw_btn_primary" invisible="state != 'arrived'" groups="carwash_base.group_carwash_user"/>
                    <button name="action_ready" type="object" string="End Service" icon="fa-flag-checkered"
                            class="btn-primary o_cw_btn_primary" invisible="state != 'in_service' or not all_services_done"
                            groups="carwash_base.group_carwash_user"/>
                    <button name="action_done" type="object" string="Complete" icon="fa-check-circle"
                            class="btn-primary o_cw_btn_primary" invisible="state != 'ready'" groups="carwash_base.group_carwash_user"/>
                    <!-- service ended (Ready) / done: invoice the customer and take the payment
                         (Register Payment confirms the order and invoices first when needed) -->
                    <field name="payment_state" invisible="1"/>
                    <field name="can_bill" invisible="1"/>
                    <button name="action_register_payment" type="object" string="Register Payment" icon="fa-money"
                            class="btn-primary o_cw_btn_primary"
                            invisible="not can_bill or payment_state == 'paid'"
                            groups="carwash_base.group_carwash_user"
                            help="Take the customer's payment (Cash by default). The invoice is created first if it isn't yet."/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" icon="fa-file-text-o"
                            invisible="not can_bill or payment_state not in ('no_order', 'quotation', 'to_invoice')"
                            groups="carwash_base.group_carwash_user"
                            help="Create and validate the customer invoice of this booking."/>
                    <button name="action_send_invoice" type="object" string="Send Invoice" icon="fa-envelope"
                            invisible="not can_bill or payment_state not in ('not_paid', 'partial')"
                            groups="carwash_base.group_carwash_user"
                            help="Email the invoice to the customer - they can pay it online with its Pay Now link."/>
                    <button name="action_print_booking" type="object" string="Print Receipt" icon="fa-print"
                            class="btn-primary o_cw_btn_primary" invisible="state != 'done'"/>
                    <button name="action_print_booking" type="object" string="Print Booking" icon="fa-print"
                            invisible="state in ('draft', 'done', 'cancelled', 'no_show')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'confirmed', 'arrived')" groups="carwash_base.group_carwash_user"/>
                    <button name="action_no_show" type="object" string="No-Show"
                            invisible="state != 'confirmed'" groups="carwash_base.group_carwash_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,arrived,in_service,ready,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="sale_order_state" invisible="1"/>
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not sale_order_id" groups="carwash_base.group_carwash_user">
                            <div class="o_stat_info">
                                <span class="o_stat_text" invisible="sale_order_state not in ('draft', 'sent')">Quotation</span>
                                <span class="o_stat_text" invisible="sale_order_state in ('draft', 'sent')">Sales Order</span>
                            </div>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not invoice_count" groups="carwash_base.group_carwash_user">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <!-- the title block is the hero header: it stays a direct child of the sheet
                         (carwash_membership anchors on //sheet/div[hasclass('oe_title')]).
                         No customer / vehicle / bay / amount fields here: other modules anchor on the first
                         //field[@name=...] of those, which must stay the ones in the groups below. -->
                    <div class="oe_title o_cw_hero o_cw_booking_hero">
                        <span class="o_cw_tile o_cw_tile_lg o_cw_tile_token" invisible="not token_no" title="Token number">
                            <span class="o_cw_tile_caption">Token</span>
                            <field name="token_no" readonly="1" class="o_cw_tile_number"/>
                        </span>
                        <span class="o_cw_tile o_cw_tile_lg o_cw_tile_muted" invisible="token_no or state not in ('cancelled', 'no_show')">
                            <i class="fa fa-ban" title="Cancelled"/>
                        </span>
                        <span class="o_cw_tile o_cw_tile_lg" invisible="token_no or state in ('cancelled', 'no_show')">
                            <i class="fa fa-car" title="Booking"/>
                        </span>
                        <div class="o_cw_hero_main">
                            <h1><field name="name" readonly="1"/></h1>
                            <div class="o_cw_hero_chips">
                                <field name="carwash_vehicle_plate" class="o_cw_plate" invisible="not carwash_vehicle_plate"/>
                                <span class="o_cw_chip">
                                    <i class="fa fa-calendar" title="Booking date"/>
                                    <field name="appointment_date" readonly="1" nolabel="1"/>
                                </span>
                                <span class="o_cw_chip o_cw_chip_success" invisible="state != 'done'">
                                    <i class="fa fa-check-circle" title="Done"/> Completed
                                </span>
                                <span class="o_cw_chip o_cw_chip_danger" invisible="state not in ('cancelled', 'no_show')">
                                    <i class="fa fa-ban" title="Cancelled"/>
                                    <span invisible="state != 'cancelled'">Cancelled</span>
                                    <span invisible="state != 'no_show'">No-Show</span>
                                </span>
                            </div>
                        </div>
                        <div class="o_cw_hero_kpis">
                            <div class="o_cw_hero_kpi" invisible="not services_total">
                                <span class="o_cw_hero_kpi_value">
                                    <field name="services_done" class="o_cw_kpi_part"/> / <field name="services_total" class="o_cw_kpi_part"/>
                                </span>
                                <span class="o_cw_hero_kpi_label">Services Done</span>
                            </div>
                            <div class="o_cw_hero_kpi">
                                <field name="duration" widget="float_time" class="o_cw_hero_kpi_value"/>
                                <span class="o_cw_hero_kpi_label">Est. Service Time</span>
                            </div>
                            <div class="o_cw_hero_kpi" invisible="not waiting_time">
                                <field name="waiting_time" digits="[16, 0]" class="o_cw_hero_kpi_value"/>
                                <span class="o_cw_hero_kpi_label">Waiting (min)</span>
                            </div>
                        </div>
                    </div>
                    <div class="o_cw_service_banner" invisible="state != 'in_service'">
                        <div class="o_cw_service_banner_text">
                            <i class="fa fa-tint" title="Service running"/>
                            <span invisible="all_services_done">
                                <strong>Service running.</strong> Start and end each service below -
                                <field name="services_done" class="o_cw_inline"/> of <field name="services_total" class="o_cw_inline"/> done.
                            </span>
                            <span invisible="not all_services_done">
                                <strong>All services finished.</strong> Click <em>End Service</em> to end the main service.
                            </span>
                        </div>
                        <field name="services_progress" widget="progressbar" class="o_cw_service_progress"/>
                    </div>
                    <group name="booking_details">
                        <group string="Customer &amp; Schedule" name="booking_customer">
                            <field name="company_id" invisible="1"/>
                            <field name="customer_id"/>
                            <field name="vehicle_id"/>
                            <field name="appointment_date" invisible="1" groups="carwash_base.group_carwash_time_slot"/>
                            <field name="appointment_date" string="Booking Date" groups="!carwash_base.group_carwash_time_slot"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="available_slot_ids" groups="carwash_base.group_carwash_time_slot" invisible="1"/>
                            <field name="booking_slot_date" groups="carwash_base.group_carwash_time_slot" string="Booking Date" required="1"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="booking_time_mode" groups="carwash_base.group_carwash_time_slot" widget="radio" options="{'horizontal': true}"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="booking_slot_id" groups="carwash_base.group_carwash_time_slot" invisible="booking_time_mode != 'slot'"
                                   options="{'no_open': True}" context="{'default_company_id': company_id}"
                                   required="booking_time_mode == 'slot'" readonly="state not in ('draft', 'confirmed')"
                                   placeholder="Pick a free time"/>
                            <field name="booking_custom_time" groups="carwash_base.group_carwash_time_slot" widget="float_time" invisible="booking_time_mode != 'custom'"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="booking_slot_info" groups="carwash_base.group_carwash_time_slot" string=" " invisible="not booking_slot_info"
                                   class="text-muted fst-italic"/>
                        </group>
                        <group string="Bay &amp; Amount" name="booking_bay">
                            <field name="bay_id"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services" name="services">
                            <field name="line_ids">
                                <list editable="bottom" class="o_cw_service_lines"
                                      decoration-muted="service_state == 'done' and not is_discount_line"
                                      decoration-info="is_discount_line">
                                    <field name="is_discount_line" column_invisible="1"/>
                                    <field name="product_id" readonly="service_state != 'pending' or is_discount_line"/>
                                    <field name="description" readonly="is_discount_line"/>
                                    <field name="quantity" readonly="service_state != 'pending' or is_discount_line"/>
                                    <field name="duration" string="Est. Time" widget="float_time" optional="show"
                                           invisible="is_discount_line"/>
                                    <field name="price_unit" readonly="is_discount_line"/>
                                    <field name="price_subtotal" readonly="1"/>
                                    <field name="service_state" widget="badge" readonly="1" invisible="is_discount_line"
                                           column_invisible="parent.state in ('draft', 'confirmed', 'cancelled', 'no_show')"
                                           decoration-info="service_state == 'in_progress'"
                                           decoration-success="service_state == 'done'"/>
                                    <field name="start_time" optional="show"
                                           column_invisible="parent.state in ('draft', 'confirmed', 'arrived', 'cancelled', 'no_show')"/>
                                    <field name="end_time" optional="show"
                                           column_invisible="parent.state in ('draft', 'confirmed', 'arrived', 'cancelled', 'no_show')"/>
                                    <field name="actual_duration" optional="show"
                                           column_invisible="parent.state in ('draft', 'confirmed', 'arrived', 'cancelled', 'no_show')"/>
                                    <button name="action_start_line" type="object" string="Start" icon="fa-play"
                                            class="o_cw_line_btn o_cw_line_btn_start"
                                            column_invisible="parent.state != 'in_service'"
                                            invisible="service_state != 'pending' or not parent.can_run_services or is_discount_line"/>
                                    <button name="action_end_line" type="object" string="End" icon="fa-stop"
                                            class="o_cw_line_btn o_cw_line_btn_end"
                                            column_invisible="parent.state != 'in_service'"
                                            invisible="service_state != 'in_progress' or not parent.can_run_services or is_discount_line"/>
                                </list>
                            </field>
                        </page>
                        <!-- what the customer paid and what goes to the staff (carwash_jobcard adds the staff side) -->
                        <page string="Payments" name="payments" invisible="state in ('draft', 'cancelled', 'no_show')"
                              groups="carwash_base.group_carwash_user">
                            <field name="currency_id" invisible="1"/>
                            <group name="payment_summary">
                                <group string="Customer" name="customer_payment">
                                    <field name="payment_state" widget="badge"
                                           decoration-muted="payment_state in ('no_order', 'quotation')"
                                           decoration-info="payment_state == 'to_invoice'"
                                           decoration-danger="payment_state == 'not_paid'"
                                           decoration-warning="payment_state == 'partial'"
                                           decoration-success="payment_state == 'paid'"/>
                                    <field name="amount_billed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount_paid" widget="monetary" options="{'currency_field': 'currency_id'}"
                                           decoration-success="amount_paid"/>
                                    <field name="amount_due" widget="monetary" options="{'currency_field': 'currency_id'}"
                                           decoration-danger="amount_due" decoration-bf="amount_due"/>
                                    <field name="amount_to_invoice" widget="monetary" options="{'currency_field': 'currency_id'}"
                                           invisible="not amount_to_invoice"/>
                                    <div class="text-muted small" colspan="2" invisible="can_bill">
                                        <i class="fa fa-info-circle me-1" title="Info"/>The quotation follows the Services tab; it is
                                        invoiced and paid once the work has passed QC (or the booking is done).
                                    </div>
                                </group>
                                <group string="Staff" name="staff_payment"/>
                            </group>
                            <separator string="Customer Payments"/>
                            <field name="customer_payment_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" no_open="1">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="journal_id" string="Paid By"/>
                                    <field name="payment_method_line_id" string="Method" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total" widget="monetary"/>
                                    <field name="state" widget="badge" decoration-success="state == 'paid'"/>
                                </list>
                            </field>
                            <separator string="Invoices" invisible="not invoice_count"/>
                            <field name="invoice_ids" nolabel="1" readonly="1" invisible="not invoice_count">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount_total_signed" string="Total" sum="Total" widget="monetary"/>
                                    <field name="amount_residual_signed" string="Due" sum="Total" widget="monetary"/>
                                    <field name="payment_state" widget="badge"
                                           decoration-success="payment_state in ('paid', 'in_payment')"
                                           decoration-warning="payment_state == 'partial'"
                                           decoration-danger="payment_state == 'not_paid'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Customer requests, damage noticed, instructions for the team..."/>
                            <group invisible="state not in ('cancelled', 'no_show')">
                                <field name="cancel_reason" invisible="state not in ('cancelled', 'no_show')"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_carwash_appointment_list" model="ir.ui.view">
        <field name="name">carwash.appointment.list</field>
        <field name="model">carwash.appointment</field>
        <field name="arch" type="xml">
            <list string="Bookings" sample="1" decoration-muted="state in ('cancelled', 'no_show')">
                <field name="name" class="fw-bold"/>
                <field name="token_no" string="Token" optional="show"/>
                <field name="customer_id" widget="many2one_avatar"/>
                <field name="vehicle_id" string="Vehicle" class="o_cw_plate_cell"/>
                <field name="appointment_date"/>
                <field name="bay_id" optional="show"/>
                <field name="duration" string="Est. Service Time" widget="float_time" optional="show"/>
                <field name="company_id" string="Branch" optional="hide" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('ready', 'done')"
                       decoration-danger="state in ('cancelled', 'no_show')"
                       decoration-warning="state == 'in_service'"
                       decoration-info="state in ('confirmed', 'arrived')"/>
                <field name="payment_state" widget="badge" optional="show" groups="carwash_base.group_carwash_user"
                       decoration-info="payment_state == 'to_invoice'"
                       decoration-danger="payment_state == 'not_paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-success="payment_state == 'paid'"/>
                <field name="amount_total" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_carwash_appointment_search" model="ir.ui.view">
        <field name="name">carwash.appointment.search</field>
        <field name="model">carwash.appointment</field>
        <field name="arch" type="xml">
            <search string="Bookings">
                <field name="name" string="Booking"/>
                <field name="vehicle_id" string="Vehicle Number" filter_domain="[('vehicle_id.license_plate', 'ilike', self)]"/>
                <field name="vehicle_id" string="Vehicle Name"
                       filter_domain="['|', ('vehicle_id.make', 'ilike', self), ('vehicle_id.vehicle_model', 'ilike', self)]"/>
                <field name="customer_id" string="Customer"/>
                <field name="booking_slot_id" string="Time Slot"/>
                <field name="bay_id"/>
                <field name="token_no" string="Token Number"/>
                <field name="booking_slot_date" string="Booking Date"/>
                <filter string="Booking Date" name="filter_booking_date" date="booking_slot_date"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('appointment_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('appointment_date', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Active Queue" name="active_queue"
                        domain="[('state', 'not in', ('done', 'cancelled', 'no_show'))]"/>
                <separator/>
                <filter string="To Confirm" name="to_confirm" domain="[('state', '=', 'draft')]"/>
                <filter string="In Service" name="in_service" domain="[('state', '=', 'in_service')]"/>
                <filter string="Ready for Pickup" name="ready_for_pickup" domain="[('state', '=', 'ready')]"/>
                <separator/>
                <filter string="Cancelled / No-Show" name="cancelled_no_show" domain="[('state', 'in', ('cancelled', 'no_show'))]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Bay" name="group_bay" context="{'group_by': 'bay_id'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Booking Day" name="group_booking_day" context="{'group_by': 'appointment_date:day'}"/>
                    <filter string="Branch" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_carwash_appointment_kanban" model="ir.ui.view">
        <field name="name">carwash.appointment.kanban</field>
        <field name="model">carwash.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column o_cw_kanban" sample="1" quick_create="false">
                <field name="state"/>
                <field name="token_no"/>
                <field name="waiting_time"/>
                <field name="all_services_done"/>
                <field name="services_done"/>
                <field name="services_total"/>
                <templates>
                    <t t-name="card">
                        <!-- coloured left edge by status -->
                        <span t-att-class="{
                            'o_cw_tone_muted': record.state.raw_value === 'draft',
                            'o_cw_tone_primary': record.state.raw_value === 'confirmed',
                            'o_cw_tone_info': record.state.raw_value === 'arrived',
                            'o_cw_tone_warning': record.state.raw_value === 'in_service',
                            'o_cw_tone_success': record.state.raw_value === 'ready' || record.state.raw_value === 'done',
                            'o_cw_tone_danger': record.state.raw_value === 'cancelled' || record.state.raw_value === 'no_show'
                        }"/>
                        <div class="o_cw_card_head">
                            <div class="d-flex align-items-center gap-2 min-w-0">
                                <span t-if="record.token_no.raw_value" class="o_cw_token" title="Token number"><field name="token_no"/></span>
                                <div class="min-w-0">
                                    <field name="vehicle_id" class="o_cw_plate"/>
                                    <div class="o_cw_card_sub"><field name="name"/></div>
                                </div>
                            </div>
                            <field t-if="record.bay_id.raw_value" name="bay_id" widget="badge" class="small"/>
                        </div>
                        <div class="o_cw_meta">
                            <!-- the customer's name (Odoo's avatar widget shows only the picture on a card) -->
                            <div class="o_cw_customer"><i class="fa fa-user" title="Customer"/><field name="customer_id"/></div>
                            <div><i class="fa fa-calendar" title="Booking date"/><field name="appointment_date"/></div>
                            <div t-if="record.state.raw_value === 'in_service' and record.services_total.raw_value">
                                <i class="fa fa-tasks" title="Services"/>
                                <span><t t-esc="record.services_done.raw_value"/>/<t t-esc="record.services_total.raw_value"/> services done</span>
                            </div>
                            <div t-if="record.waiting_time.raw_value"
                                 t-att-class="record.waiting_time.raw_value > 15 ? 'text-danger fw-bold' : ''">
                                <i class="fa fa-hourglass-half" title="Waiting time"/>
                                <span>Waiting: <t t-esc="Math.round(record.waiting_time.raw_value)"/> min</span>
                            </div>
                        </div>
                        <footer>
                            <div class="d-flex flex-wrap gap-1">
                                <a name="action_arrive" type="object" role="button" class="btn btn-sm btn-primary o_cw_btn_primary"
                                   invisible="state != 'confirmed'" groups="carwash_base.group_carwash_user">Vehicle Arrived</a>
                                <a name="action_start_service" type="object" role="button" class="btn btn-sm btn-primary o_cw_btn_primary"
                                   invisible="state != 'arrived'" groups="carwash_base.group_carwash_user">Start Service</a>
                                <a name="action_ready" type="object" role="button" class="btn btn-sm btn-primary o_cw_btn_primary"
                                   invisible="state != 'in_service' or not all_services_done" groups="carwash_base.group_carwash_user">End Service</a>
                                <a name="action_done" type="object" role="button" class="btn btn-sm btn-primary o_cw_btn_primary"
                                   invisible="state != 'ready'" groups="carwash_base.group_carwash_user">Complete</a>
                            </div>
                            <span class="ms-auto fw-bold text-nowrap" title="Amount">
                                <i class="fa fa-money me-1" title="Amount"/><field name="amount_total"/>
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_carwash_appointment_queue" model="ir.actions.act_window">
        <field name="name">Queue</field>
        <field name="res_model">carwash.appointment</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="domain">[('state', 'not in', ('done', 'cancelled', 'no_show')), ('appointment_date', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0, 0, 0)))]</field>
        <field name="context">{'search_default_active_queue': 1}</field>
    </record>

    <record id="action_carwash_appointment_all" model="ir.actions.act_window">
        <field name="name">All Bookings</field>
        <field name="res_model">carwash.appointment</field>
        <field name="view_mode">kanban,list,calendar,form</field>
    </record>

    <record id="action_carwash_appointment_new" model="ir.actions.act_window">
        <field name="name">New Booking</field>
        <field name="res_model">carwash.appointment</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
