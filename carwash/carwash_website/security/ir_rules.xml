<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Portal users only ever reach these two models through their own bookings -
            group-specific rule (only applies to base.group_portal) so it doesn't OR
            with the internal-staff branch-isolation rules in carwash_multibranch,
            which are global (no groups) and always AND in regardless.
        -->
        <record id="carwash_website_rule_portal_appointment" model="ir.rule">
            <field name="name">Car Wash Booking: Portal Own Bookings Only</field>
            <field name="model_id" ref="carwash_base.model_carwash_appointment"/>
            <field name="domain_force">[('customer_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="carwash_website_rule_portal_vehicle" model="ir.rule">
            <field name="name">Car Wash Vehicle: Portal Own Vehicles Only</field>
            <field name="model_id" ref="carwash_base.model_carwash_vehicle"/>
            <field name="domain_force">[('customer_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
