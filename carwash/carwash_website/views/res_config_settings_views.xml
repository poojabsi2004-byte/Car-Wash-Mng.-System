<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_carwash" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.carwash.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="inside">
                <setting string="Car Wash Service Packages"
                         help="Let customers see every service package and what's included before they book, right on the homepage.">
                    <field name="carwash_show_packages"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
