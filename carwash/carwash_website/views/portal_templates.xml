<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_carwash" name="My Bookings" customize_show="True" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Car Wash Bookings</t>
                <t t-set="url" t-value="'/my/bookings'"/>
                <t t-set="text">Book a wash or view your bookings</t>
                <t t-set="placeholder_count" t-value="'booking_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_bookings" name="My Bookings">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Bookings</t>
            </t>
            <div t-if="membership" class="alert alert-success d-flex align-items-center gap-2 mt-3" role="alert">
                <i class="fa fa-id-card"/>
                <span><strong t-esc="membership.plan_id.name"/> member
                    <t t-if="membership.washes_remaining &gt;= 0"> · <t t-esc="membership.washes_remaining"/> free wash(es) left</t>
                    - open a booking below to apply your membership before the service starts.</span>
            </div>
            <div id="carwash_booking_requests"/>
            <div t-if="not appointments" class="alert alert-warning" role="alert">
                You have no bookings yet. <a href="/car-wash/book">Book a car wash</a>.
            </div>
            <t t-if="appointments" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Booking #</th>
                        <th>Vehicle</th>
                        <th class="text-end">Date</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Status</th>
                        <th t-if="review_enabled" class="text-end">Your Rating</th>
                    </tr>
                </thead>
                <t t-foreach="appointments" t-as="appointment">
                    <tr>
                        <td><a t-attf-href="/my/bookings/#{appointment.id}"><t t-out="appointment.name"/></a></td>
                        <td><t t-out="appointment.vehicle_id.license_plate"/></td>
                        <td class="text-end" t-esc="appointment._slot_local(appointment.appointment_date).strftime('%d %b, %y %I:%M %p')"/>
                        <td class="text-end">
                            <t t-esc="'%.2f' % appointment.amount_total"/>
                            <span t-if="appointment.membership_id" class="badge text-bg-success ms-1" title="Membership applied">
                                <i class="fa fa-id-card"/></span>
                        </td>
                        <td class="text-end"><span t-field="appointment.state"/></td>
                        <td t-if="review_enabled" class="text-end text-nowrap">
                            <t t-if="appointment.carwash_review_stars">
                                <t t-set="stars" t-value="int(appointment.carwash_review_stars)"/>
                                <span class="o_cw_stars" t-att-title="'%s / 5' % stars">
                                    <i t-foreach="range(5)" t-as="i" t-attf-class="fa fa-star #{'o_cw_star_on' if i &lt; stars else 'o_cw_star_off'}"/>
                                </span>
                            </t>
                            <a t-elif="appointment.state == 'done'" t-attf-href="/my/bookings/#{appointment.id}#carwash_review"
                               class="btn btn-sm btn-outline-primary"><i class="fa fa-star me-1"/>Rate</a>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_booking_page" name="Booking Detail">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="object.name"/>
            <div class="card p-4">
                <h3><t t-out="object.name"/></h3>
                <div t-if="message == 'applied'" class="alert alert-success">
                    Membership applied - you save <strong t-esc="'%.2f' % object.membership_saving"/> on this booking.</div>
                <div t-if="message == 'removed'" class="alert alert-info">Membership removed - normal prices apply.</div>
                <div t-if="error == 'no_benefit'" class="alert alert-warning">
                    Your membership gives no benefit on these services (or your free washes for this cycle are used up).</div>
                <div t-if="error == 'no_membership'" class="alert alert-warning">
                    You don't have an active membership. <a href="/car-wash/membership">See the plans</a>.</div>
                <div t-if="error == 'review_not_done'" class="alert alert-warning">
                    You can rate this booking once your wash is completed.</div>
                <div t-if="error == 'locked'" class="alert alert-warning">
                    The service has already started - the membership can't be changed any more.</div>
                <p>
                    <strong>Branch:</strong> <t t-out="object.company_id.name"/><br/>
                    <strong>Vehicle:</strong> <t t-out="object.vehicle_id.license_plate"/><br/>
                    <strong>Date:</strong> <t t-esc="object._slot_local(object.appointment_date).strftime('%d %b, %y %I:%M %p')"/><br/>
                    <strong>Status:</strong> <span t-field="object.state"/>
                </p>
                <table class="table" t-if="object.line_ids">
                    <thead>
                        <tr><th>Service</th><th class="text-end">Qty</th><th class="text-end">Price</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="object.line_ids" t-as="line">
                            <td>
                                <t t-out="line.product_id.display_name"/>
                                <span t-if="line.membership_covered" class="badge text-bg-success ms-1">Free with membership</span>
                                <span t-elif="line.is_discount_line" class="badge text-bg-info ms-1">Membership</span>
                                <div t-if="line.is_discount_line" class="small text-muted" t-esc="line.description"/>
                            </td>
                            <td class="text-end"><t t-if="not line.is_discount_line" t-out="line.quantity"/></td>
                            <td class="text-end">
                                <small t-if="line.membership_covered" class="text-muted text-decoration-line-through me-1"
                                       t-esc="'%.2f' % (line.price_before_membership * line.quantity)"/>
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr t-if="object.membership_id and object.membership_saving">
                            <td colspan="3" class="text-end text-success small">
                                You save <t t-esc="'%.2f' % object.membership_saving"/> with your membership</td>
                        </tr>
                        <tr>
                            <td colspan="2" class="text-end fw-bold">Total</td>
                            <td class="text-end fw-bold" t-esc="'%.2f' % object.amount_total"/>
                        </tr>
                    </tfoot>
                </table>
                <div t-if="object.membership_id or membership" class="o_cw_member_option rounded p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <i class="fa fa-id-card me-1"/>
                        <t t-if="object.membership_id">
                            <strong t-esc="object.membership_id.plan_id.name"/> membership applied to this booking.
                        </t>
                        <t t-elif="can_apply_membership">
                            You're a <strong t-esc="membership.plan_id.name"/> member - apply it to pay
                            <strong t-esc="'%.2f' % membership_preview['member']"/>
                            instead of <t t-esc="'%.2f' % membership_preview['normal']"/>
                            (save <t t-esc="'%.2f' % membership_preview['saving']"/><t t-if="membership_preview['free_wash']">, uses 1 free wash</t>).
                        </t>
                        <t t-else="">
                            You're a <strong t-esc="membership.plan_id.name"/> member, but the plan gives no benefit
                            on these services<t t-if="membership.washes_remaining == 0"> (free washes for this cycle are used up)</t>.
                        </t>
                    </div>
                    <form t-if="can_apply_membership or can_remove_membership"
                          t-attf-action="/my/bookings/#{object.id}/membership" method="post" class="m-0">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="apply" t-att-value="'1' if can_apply_membership else '0'"/>
                        <button t-if="can_apply_membership" type="submit" class="btn btn-primary btn-sm">
                            <i class="fa fa-check me-1"/>Apply my membership</button>
                        <button t-else="" type="submit" class="btn btn-link btn-sm text-danger">Remove membership</button>
                    </form>
                </div>
                <!-- Review & rating: once the service is done (Odoo rating.rating) -->
                <div t-if="review_enabled and object.state == 'done'" id="carwash_review" class="o_cw_review border-top mt-4 pt-3">
                    <div t-if="message == 'reviewed'" class="alert alert-success">Thank you for your review!</div>
                    <div t-if="error == 'review'" class="alert alert-warning">Please choose a rating from 1 to 5 stars.</div>
                    <t t-set="current_stars" t-value="int(object.carwash_review_stars or 0)"/>
                    <h5 t-if="current_stars">Your review</h5>
                    <h5 t-else="">How was your wash?</h5>
                    <p class="text-muted small mb-2">Rate the service and tell us about your experience.</p>
                    <form t-attf-action="/my/bookings/#{object.id}/review" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="o_cw_star_input mb-2" role="radiogroup" aria-label="Rating">
                            <t t-foreach="[5, 4, 3, 2, 1]" t-as="star">
                                <input type="radio" name="stars" required="required" t-att-id="'cw_star_%s' % star"
                                       t-att-value="star" t-att-checked="'checked' if current_stars == star else None"/>
                                <label t-att-for="'cw_star_%s' % star" t-att-title="'%s star%s' % (star, 's' if star &gt; 1 else '')">
                                    <i class="fa fa-star"/></label>
                            </t>
                        </div>
                        <textarea name="feedback" class="form-control mb-2" rows="3" maxlength="2000"
                                  placeholder="Your review (optional)"><t t-esc="object.carwash_review_feedback or ''"/></textarea>
                        <button type="submit" class="btn btn-primary">
                            <t t-if="current_stars">Update review</t><t t-else="">Submit review</t></button>
                    </form>
                </div>
            </div>
        </t>
    </template>

</odoo>
