<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carwash_appointment_form_membership" model="ir.ui.view">
        <field name="name">carwash.appointment.form.membership</field>
        <field name="model">carwash.appointment</field>
        <field name="inherit_id" ref="carwash_base.view_carwash_appointment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="after">
                <field name="customer_membership_id" invisible="1"/>
                <field name="membership_id" invisible="1"/>
                <div class="o_cw_member_banner" invisible="not customer_membership_id" groups="carwash_membership.group_carwash_membership">
                    <div class="o_cw_member_banner_icon"><i class="fa fa-id-card" title="Membership"/></div>
                    <div class="o_cw_member_banner_body">
                        <div>
                            <strong>Member:</strong>
                            <field name="customer_membership_id" readonly="1" nolabel="1" class="o_cw_inline"/>
                            <span class="o_cw_member_state" invisible="not membership_id"><i class="fa fa-check"/> applied</span>
                        </div>
                        <div class="text-muted small">
                            <field name="membership_benefit" readonly="1" nolabel="1" class="o_cw_inline"/>
                            <span invisible="membership_washes_left &lt; 0"> · free washes left:
                                <field name="membership_washes_left" readonly="1" nolabel="1" class="o_cw_inline"/></span>
                            <span invisible="not membership_id"> · saving
                                <field name="membership_saving" readonly="1" nolabel="1" class="o_cw_inline"/></span>
                        </div>
                    </div>
                    <div class="o_cw_member_banner_actions" invisible="state not in ('draft', 'confirmed', 'arrived', 'in_service', 'ready')"
                         groups="carwash_base.group_carwash_user">
                        <button name="action_apply_membership" type="object" string="Apply Membership" icon="fa-check"
                                class="btn btn-primary o_cw_btn_primary btn-sm" invisible="membership_id or state in ('in_service', 'ready')"/>
                        <button name="action_apply_membership" type="object" string="Re-apply" icon="fa-refresh"
                                class="btn btn-link btn-sm" invisible="not membership_id or state in ('in_service', 'ready')"
                                title="Recalculate after changing services or the package"/>
                        <button name="action_remove_membership" type="object" string="Remove" icon="fa-times"
                                class="btn btn-link btn-sm text-danger" invisible="not membership_id"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//page[@name='services']/field[@name='line_ids']/list/field[@name='price_subtotal']" position="after">
                <field name="membership_covered" column_invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='services']/field[@name='line_ids']/list" position="attributes">
                <attribute name="decoration-success">membership_covered</attribute>
            </xpath>
        </field>
    </record>
</odoo>
