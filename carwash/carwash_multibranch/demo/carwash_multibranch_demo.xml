<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================ a customer and a booking at a branch -->
    <record id="demo_customer_satellite" model="res.partner">
        <field name="name">Marcus Tan</field>
        <field name="email">marcus.tan@example.com</field>
        <field name="company_id" ref="demo_company_satellite"/>
    </record>
    <record id="demo_vehicle_satellite" model="carwash.vehicle">
        <field name="license_plate">GJ01AB1122</field>
        <field name="customer_id" ref="demo_customer_satellite"/>
        <field name="make">Kia</field>
        <field name="vehicle_model">Sportage</field>
        <field name="vehicle_type_id" ref="carwash_base.vehicle_type_suv"/>
        <field name="color">Blue</field>
        <field name="company_id" ref="demo_company_satellite"/>
    </record>
    <record id="demo_appointment_satellite_1" model="carwash.appointment">
        <field name="customer_id" ref="demo_customer_satellite"/>
        <field name="vehicle_id" ref="demo_vehicle_satellite"/>
        <field name="company_id" ref="demo_company_satellite"/>
        <field name="bay_id" ref="demo_bay_satellite_1"/>
        <field name="line_ids" model="product.product" eval="[
            (0, 0, {'product_id': obj().env.ref('carwash_base.demo_service_premium').product_variant_id.id, 'quantity': 1}),
        ]"/>
    </record>
    <function model="carwash.appointment" name="action_confirm" eval="[[ref('demo_appointment_satellite_1')]]"/>
    <function model="carwash.appointment" name="action_arrive" eval="[[ref('demo_appointment_satellite_1')]]"/>

    <!-- ============================================================ users -->
    <record id="demo_user_owner" model="res.users">
        <field name="name">Owner Account</field>
        <field name="login">owner@carwash.example.com</field>
        <field name="email">owner@carwash.example.com</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[(6, 0, [ref('base.main_company'), ref('demo_company_satellite'),
                                                 ref('demo_company_navrangpura'), ref('demo_company_sg_highway'),
                                                 ref('demo_company_maninagar'), ref('demo_company_vastrapur')])]"/>
        <field name="group_ids" eval="[(4, ref('group_carwash_owner'))]"/>
    </record>

    <record id="demo_user_satellite_manager" model="res.users">
        <field name="name">Satellite Branch Manager</field>
        <field name="login">satellite.manager@carwash.example.com</field>
        <field name="email">satellite.manager@carwash.example.com</field>
        <field name="company_id" ref="demo_company_satellite"/>
        <field name="company_ids" eval="[(6, 0, [ref('demo_company_satellite')])]"/>
        <field name="group_ids" eval="[(4, ref('carwash_base.group_carwash_manager'))]"/>
    </record>

</odoo>
