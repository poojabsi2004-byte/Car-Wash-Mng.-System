    <!-- the administrator works at every branch (company switcher) -->
    <function model="res.users" name="write">
        <value eval="[ref('base.user_admin')]"/>
        <value eval="{'company_ids': [(4, ref('demo_company_satellite')), (4, ref('demo_company_navrangpura')), (4, ref('demo_company_sg_highway')), (4, ref('demo_company_maninagar')), (4, ref('demo_company_vastrapur'))]}"/>
