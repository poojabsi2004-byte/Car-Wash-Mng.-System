<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Five branches of the main company (a branch = a sub-company), each with its own warehouse, branch code
         (numbering: SAT/26/0001...) and 3-4 bays (hand wash, tunnel, detailing). Regular data, so every new
         database starts with them (with or without demo data); edit, archive or add branches as needed -
         noupdate: upgrades never change or bring back what you changed. forcecreate="0": created on install only -
         on an upgrade a new company can't be made while some modules aren't loaded yet (e.g. Timesheets' Internal
         project of the company): migrations/19.0.1.7.0/end-migrate.py adds missing branches then. -->

    <!-- ============================================================ Satellite Branch -->
    <record id="demo_company_satellite" model="res.company" forcecreate="0">
        <field name="name">Satellite Branch</field>
        <field name="parent_id" ref="base.main_company"/>
        <field name="carwash_code">SAT</field>
        <field name="street">Satellite Road</field>
        <field name="city">Ahmedabad</field>
        <field name="phone">+91 79 4000 1001</field>
    </record>
    <record id="demo_warehouse_satellite" model="stock.warehouse" forcecreate="0">
        <field name="name">Satellite Branch</field>
        <field name="code">SAT</field>
        <field name="company_id" ref="demo_company_satellite"/>
        <field name="partner_id" model="res.company" eval="obj(ref('demo_company_satellite')).partner_id.id"/>
    </record>
    <record id="demo_bay_satellite_1" model="carwash.bay" forcecreate="0">
        <field name="name">SAT Bay 1</field>
        <field name="bay_type_id" ref="carwash_base.bay_type_hand"/>
        <field name="company_id" ref="demo_company_satellite"/>
    </record>
    <record id="demo_bay_satellite_2" model="carwash.bay" forcecreate="0">
        <field name="name">SAT Bay 2</field>
        <field name="bay_type_id" ref="carwash_base.bay_type_tunnel"/>
        <field name="company_id" ref="demo_company_satellite"/>
    </record>
    <record id="demo_bay_satellite_3" model="carwash.bay" forcecreate="0">
        <field name="name">SAT Bay 3</field>
        <field name="bay_type_id" ref="carwash_base.bay_type_detail"/>
        <field name="company_id" ref="demo_company_satellite"/>
    </record>
    <record id="demo_bay_satellite_4" model="carwash.bay" forcecreate="0">
        <field name="name">SAT Bay 4</field>
        <field name="bay_type_id" ref="carwash_base.bay_type_hand"/>
        <field name="company_id" ref="demo_company_satellite"/>
    </record>

