<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- features start switched on; Car Wash > Configuration > Settings turns them off -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('carwash_jobcard.group_carwash_package')),
            (4, ref('carwash_jobcard.group_carwash_inspection')),
            (4, ref('carwash_jobcard.group_carwash_checklist')),
            (4, ref('carwash_jobcard.group_carwash_commission')),
            (4, ref('carwash_jobcard.group_carwash_rating')),
        ]"/>
    </record>
</odoo>
