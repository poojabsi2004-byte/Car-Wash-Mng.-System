<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- New Staff Member: a user form - saving it creates the user, then the employee linked to it -->
    <record id="view_carwash_staff_user_form" model="ir.ui.view">
        <field name="name">res.users.form.carwash.staff</field>
        <field name="model">res.users</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="New Staff Member" class="o_cw_form">
                <div class="o_cw_hero">
                    <span class="o_cw_tile o_cw_tile_lg"><i class="fa fa-user-plus" title="New staff member"/></span>
                    <div class="oe_title">
                        <label for="name" string="Staff Member"/>
                        <h1><field name="name" required="1" placeholder="e.g. Ramesh Kumar"/></h1>
                    </div>
                </div>
                <div class="alert alert-info mb-3" role="status">
                    <i class="fa fa-info-circle me-1" title="Info"/>Staff are created as a <b>user</b> (to log in and use the Car Wash app) and, with it, as an
                    <b>employee</b> linked to that user. Only staff with a user can be assigned to job cards.
                </div>
                <group>
                    <group string="Login" name="login">
                        <field name="login" string="Email / Login" placeholder="e.g. ramesh@yourcarwash.com"
                               help="Used to log in. With an email address the person gets an invitation to set a password."/>
                        <field name="password" password="True" placeholder="Leave empty to send an invitation email"
                               help="Optional. Leave empty to send an invitation email instead (needs an email address as login)."/>
                        <field name="phone"/>
                    </group>
                    <group string="Work" name="work">
                        <field name="carwash_branch_id" required="1" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="carwash_access" widget="radio" required="1"/>
                        <field name="carwash_role_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_carwash_open_staff" type="object" string="Create Staff Member" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_carwash_staff_new" model="ir.actions.act_window">
        <field name="name">New Staff Member</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_carwash_staff_user_form"/>
        <field name="target">new</field>
        <field name="context">{'carwash_new_staff': True}</field>
    </record>
</odoo>
