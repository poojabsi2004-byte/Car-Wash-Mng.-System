<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carwash_appointment_form_jobcard" model="ir.ui.view">
        <field name="name">carwash.appointment.form.jobcard</field>
        <field name="model">carwash.appointment</field>
        <field name="inherit_id" ref="carwash_base.view_carwash_appointment_form"/>
        <field name="arch" type="xml">
            <!-- Vehicle arrived: pre-wash inspection comes before starting the service -->
            <xpath expr="//button[@name='action_start_service']" position="before">
                <field name="has_pre_inspection" invisible="1"/>
                <field name="inspection_feature_enabled" invisible="1"/>
                <button name="action_open_inspection" type="object" string="Inspection" icon="fa-search"
                        class="btn-primary o_cw_btn_primary" invisible="state != 'arrived' or has_pre_inspection or not inspection_feature_enabled"
                        groups="carwash_base.group_carwash_user,carwash_jobcard.group_carwash_washer,carwash_jobcard.group_carwash_qc"/>
                <button name="action_open_inspection" type="object" string="View Inspection" icon="fa-eye"
                        class="btn-secondary" invisible="state != 'arrived' or not has_pre_inspection or not inspection_feature_enabled"
                        groups="carwash_base.group_carwash_user,carwash_jobcard.group_carwash_washer,carwash_jobcard.group_carwash_qc"/>
            </xpath>
            <!-- Once the main service has ended (all services done), the post-wash inspection is next -->
            <xpath expr="//button[@name='action_done']" position="before">
                <field name="has_post_inspection" invisible="1"/>
                <button name="action_open_inspection" type="object" string="Inspection" icon="fa-search"
                        class="btn-primary o_cw_btn_primary" invisible="state != 'ready' or has_post_inspection or not inspection_feature_enabled"
                        groups="carwash_base.group_carwash_user,carwash_jobcard.group_carwash_washer,carwash_jobcard.group_carwash_qc"/>
                <button name="action_open_inspection" type="object" string="View Inspection" icon="fa-eye"
                        class="btn-secondary" invisible="state != 'ready' or not has_post_inspection or not inspection_feature_enabled"
                        groups="carwash_base.group_carwash_user,carwash_jobcard.group_carwash_washer,carwash_jobcard.group_carwash_qc"/>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="carwash_review_id" invisible="1"/>
                <button name="action_add_review" type="object" string="Add Review" icon="fa-star"
                        class="btn-primary o_cw_btn_primary"
                        invisible="state != 'done' or not rating_feature_enabled or carwash_review_id" groups="carwash_base.group_carwash_user"
                        help="Record the customer's rating (1-5 stars) and review of this wash."/>
                <button name="action_add_review" type="object" string="Edit Review" icon="fa-star"
                        invisible="state != 'done' or not rating_feature_enabled or not carwash_review_id" groups="carwash_base.group_carwash_user"/>
            </xpath>
            <!-- work passed QC / done: pay what the crew and the QC earned on the booking (a bill per person, paid from Cash) -->
            <xpath expr="//button[@name='action_send_invoice']" position="after">
                <field name="staff_to_pay" invisible="1"/>
                <field name="qc_to_pay" invisible="1"/>
                <button name="action_pay_staff" type="object" string="Pay Staff" icon="fa-users"
                        invisible="not can_bill or not staff_to_pay" groups="carwash_base.group_carwash_manager"
                        help="Pay what the crew earned on this booking: bills created when needed, then the payment (Cash by default)."/>
                <button name="action_pay_qc" type="object" string="Pay QC" icon="fa-check-square-o"
                        invisible="not can_bill or not qc_to_pay" groups="carwash_base.group_carwash_manager"
                        help="Pay what the QC inspectors earned on this booking: bills created when needed, then the payment (Cash by default)."/>
            </xpath>
            <!-- Payments tab: the staff side -->
            <xpath expr="//group[@name='staff_payment']" position="attributes">
                <attribute name="groups">carwash_jobcard.group_carwash_commission</attribute>
            </xpath>
            <xpath expr="//group[@name='staff_payment']" position="inside">
                <field name="staff_payable_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="qc_payable_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="staff_paid" widget="monetary" options="{'currency_field': 'currency_id'}"
                       decoration-success="staff_paid"/>
                <field name="staff_to_pay" widget="monetary" options="{'currency_field': 'currency_id'}"
                       decoration-warning="staff_to_pay" decoration-bf="staff_to_pay"/>
                <field name="qc_to_pay" widget="monetary" options="{'currency_field': 'currency_id'}"
                       decoration-warning="qc_to_pay" decoration-bf="qc_to_pay"/>
                <field name="amount_kept" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-bf="1"/>
                <div class="text-muted small" colspan="2">
                    <i class="fa fa-info-circle me-1" title="Info"/>The staff and QC payables are recorded when a job card
                    passes QC. After End Service, <b>Pay Staff</b> / <b>Pay QC</b> create the bill per person (when needed) and open
                    the payment.
                </div>
            </xpath>
            <xpath expr="//page[@name='payments']" position="inside">
                <separator string="Staff Payables" groups="carwash_jobcard.group_carwash_commission"/>
                <field name="staff_payable_ids" nolabel="1" readonly="1" groups="carwash_jobcard.group_carwash_commission">
                    <list create="0" delete="0" decoration-muted="state == 'cancelled'" decoration-success="state == 'paid'">
                        <field name="employee_id" widget="many2one_avatar_employee"/>
                        <field name="payable_role" widget="badge" decoration-info="payable_role == 'qc'"/>
                        <field name="jobcard_id"/>
                        <field name="commission_type" string="Type" optional="show"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="amount" sum="Total" widget="monetary"/>
                        <field name="state" widget="badge" decoration-warning="state == 'to_pay'" decoration-success="state == 'paid'"/>
                        <field name="paid_date" optional="show"/>
                        <field name="bill_id" optional="show"/>
                    </list>
                </field>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_staff_bills" type="object" class="oe_stat_button" icon="fa-users"
                        invisible="not staff_bill_count" groups="carwash_base.group_carwash_manager">
                    <field name="staff_bill_count" widget="statinfo" string="Staff Bills"/>
                </button>
                <field name="rating_feature_enabled" invisible="1"/>
                <button name="action_view_ratings" type="object" class="oe_stat_button" icon="fa-smile-o"
                        invisible="not rating_count" groups="carwash_jobcard.group_carwash_rating">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="rating_avg" digits="[16, 1]"/> / 5</span>
                        <span class="o_stat_text">Customer Rating</span>
                    </div>
                    <field name="rating_count" invisible="1"/>
                </button>
                <button name="action_view_jobcards" type="object" class="oe_stat_button" icon="fa-wrench"
                        invisible="jobcard_count == 0">
                    <field name="jobcard_count" widget="statinfo" string="Job Cards"/>
                </button>
                <button name="action_view_inspections" type="object" class="oe_stat_button" icon="fa-search" groups="carwash_jobcard.group_carwash_inspection"
                        invisible="inspection_count == 0">
                    <field name="inspection_count" widget="statinfo" string="Inspections"/>
                </button>
            </xpath>
            <!-- Package: picked up front, fills the Services list at the package price -->
            <xpath expr="//field[@name='vehicle_id']" position="after">
                <field name="service_package_id" placeholder="Select a package (optional)" groups="carwash_jobcard.group_carwash_package"
                       options="{'no_create': True}"
                       readonly="state not in ('draft', 'confirmed', 'arrived') or not can_manage_details"/>
            </xpath>
            <xpath expr="//page[@name='services']/field[@name='line_ids']" position="before">
                <div class="o_cw_package_card" invisible="not service_package_id" groups="carwash_jobcard.group_carwash_package">
                    <div class="o_cw_package_card_icon"><i class="fa fa-gift" title="Service package"/></div>
                    <div class="o_cw_package_card_body">
                        <div class="o_cw_package_card_title">
                            <field name="service_package_id" readonly="1" nolabel="1" options="{'no_open': True}"/>
                            <span class="o_cw_package_badge">Package</span>
                        </div>
                        <div class="o_cw_package_card_meta">
                            Package amount <strong><field name="package_amount" class="o_cw_inline"/></strong>
                            <span invisible="not package_saving"> · customer saves
                                <strong><field name="package_saving" class="o_cw_inline"/></strong></span>
                        </div>
                    </div>
                    <div class="o_cw_package_card_actions" invisible="state not in ('draft', 'confirmed', 'arrived')"
                         groups="carwash_base.group_carwash_user">
                        <button name="action_apply_service_package" type="object" string="Reset Package"
                                icon="fa-refresh" class="btn btn-link" title="Re-apply the package's current services and price"/>
                        <button name="action_remove_service_package" type="object" string="Remove"
                                icon="fa-times" class="btn btn-link text-danger"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//page[@name='services']/field[@name='line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="readonly">service_state != 'pending' or package_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//page[@name='services']/field[@name='line_ids']/list/field[@name='quantity']" position="attributes">
                <attribute name="readonly">service_state != 'pending' or package_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//page[@name='services']/field[@name='line_ids']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">package_id or jobcard_consumption_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//page[@name='services']/field[@name='line_ids']/list/field[@name='product_id']" position="after">
                <field name="jobcard_consumption_id" column_invisible="1"/>
                <field name="package_id" widget="badge" optional="show" decoration-info="package_id" force_save="1"/>
                <field name="jobcard_id" optional="show" readonly="1" options="{'no_open': True}"
                       column_invisible="parent.state in ('draft', 'confirmed', 'arrived')"/>
            </xpath>
            <xpath expr="//page[@name='services']/field[@name='line_ids']" position="after">
                <group class="oe_subtotal_footer" invisible="not line_ids">
                    <field name="package_amount" string="Package" invisible="not service_package_id" groups="carwash_jobcard.group_carwash_package"/>
                    <field name="extra_services_amount" string="Extra Services" invisible="not service_package_id" groups="carwash_jobcard.group_carwash_package"/>
                    <field name="amount_total" string="Total" class="oe_subtotal_footer_separator"/>
                </group>
            </xpath>
            <!-- Check-in checklist: mandatory tasks must be ticked before the service can start -->
            <xpath expr="//page[@name='services']" position="after">
                <page string="Customer Review" name="customer_review" invisible="not carwash_review_id or not rating_feature_enabled"
                      groups="carwash_jobcard.group_carwash_rating">
                    <group>
                        <group>
                            <field name="carwash_review_stars" widget="priority" readonly="1"/>
                            <field name="carwash_review_feedback" readonly="1" placeholder="No written review"/>
                        </group>
                    </group>
                </page>
                <page string="Check-in Checklist" name="checklist" groups="carwash_jobcard.group_carwash_checklist"
                      invisible="state in ('draft', 'confirmed', 'cancelled', 'no_show') and not checklist_line_ids">
                    <group>
                        <group>
                            <field name="checklist_template_id" options="{'no_create': True}" placeholder="Pick a checklist"
                                   readonly="state not in ('draft', 'confirmed', 'arrived')"/>
                        </group>
                        <group>
                            <field name="checklist_progress" widget="progressbar" invisible="not checklist_line_ids"/>
                            <field name="checklist_pending_count" invisible="checklist_complete" decoration-danger="1"/>
                        </group>
                    </group>
                    <field name="checklist_line_ids" readonly="state not in ('draft', 'confirmed', 'arrived')"/>
                </page>
            </xpath>
            <xpath expr="//div[hasclass('o_cw_service_banner')]" position="before">
                <field name="checklist_complete" invisible="1"/>
                <field name="open_inspection_count" invisible="1"/>
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert"
                     invisible="state != 'arrived' or (checklist_complete and not open_inspection_count)">
                    <i class="fa fa-list-ul"/>
                    <span invisible="checklist_complete" groups="carwash_jobcard.group_carwash_checklist">
                        <strong>Check-in pending:</strong>&#160;<field name="checklist_pending_count" class="o_cw_inline"/> mandatory task(s) left on the
                        <em>Check-in Checklist</em> tab.
                    </span>
                    <span invisible="not open_inspection_count" groups="carwash_jobcard.group_carwash_inspection">
                        <strong>Inspection in progress</strong> - complete it before starting the service.
                    </span>
                </div>
            </xpath>
            <!-- Starting service is the washer's own action (matches the Job Card "Start" button),
                 not Front Desk's - Front Desk assigns the bay, the washer starts the work in it. -->
            <xpath expr="//button[@name='action_start_service']" position="attributes">
                <attribute name="groups">carwash_jobcard.group_carwash_washer,carwash_base.group_carwash_manager</attribute>
            </xpath>
            <!-- Washer now has write access to carwash.appointment so that button works, but should
                 only ever touch the workflow buttons - lock the customer/vehicle/bay/services/notes
                 fields to Front Desk/Manager so that broadened access doesn't also let them edit
                 unrelated appointment details. -->
            <xpath expr="//field[@name='customer_id']" position="before">
                <field name="can_manage_details" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='customer_id']" position="attributes">
                <attribute name="readonly">not can_manage_details</attribute>
            </xpath>
            <xpath expr="//field[@name='vehicle_id']" position="attributes">
                <attribute name="readonly">not can_manage_details</attribute>
            </xpath>
            <xpath expr="//field[@name='bay_id']" position="attributes">
                <attribute name="readonly">not can_manage_details</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="readonly">not can_manage_details</attribute>
            </xpath>
            <xpath expr="//page[@name='notes']/field[@name='notes']" position="attributes">
                <attribute name="readonly">not can_manage_details</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_carwash_appointment_kanban_jobcard" model="ir.ui.view">
        <field name="name">carwash.appointment.kanban.jobcard</field>
        <field name="model">carwash.appointment</field>
        <field name="inherit_id" ref="carwash_base.view_carwash_appointment_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//a[@name='action_start_service']" position="attributes">
                <attribute name="groups">carwash_jobcard.group_carwash_washer,carwash_base.group_carwash_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
