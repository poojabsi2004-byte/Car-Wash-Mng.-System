<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carwash_checklist_template_list" model="ir.ui.view">
        <field name="name">carwash.checklist.template.list</field>
        <field name="model">carwash.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Checklist Templates" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name" class="fw-bold"/>
                <field name="checklist_type_id" widget="badge" decoration-info="1"/>
                <field name="inspection_type_id" optional="show"/>
                <field name="vehicle_type_ids" widget="many2many_tags" optional="show"/>
                <field name="usage_count" string="Used" optional="hide"/>
                <field name="is_default" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_carwash_checklist_template_form" model="ir.ui.view">
        <field name="name">carwash.checklist.template.form</field>
        <field name="model">carwash.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Template" class="o_cw_form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_usage" type="object" class="oe_stat_button" icon="fa-calendar"
                                invisible="checklist_type != 'booking'">
                            <field name="usage_count" widget="statinfo" string="Bookings"/>
                        </button>
                        <button name="action_view_usage" type="object" class="oe_stat_button" icon="fa-search"
                                invisible="checklist_type != 'inspection'">
                            <field name="usage_count" widget="statinfo" string="Inspections"/>
                        </button>
                        <button name="action_view_usage" type="object" class="oe_stat_button" icon="fa-wrench"
                                invisible="checklist_type != 'jobcard'">
                            <field name="usage_count" widget="statinfo" string="Job Cards"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="o_cw_hero">
                        <span class="o_cw_tile o_cw_tile_lg" invisible="checklist_type not in ('booking', 'inspection', 'jobcard')">
                            <i class="fa fa-check-square-o" title="Checklist"/>
                        </span>
                        <span class="o_cw_tile o_cw_tile_lg" invisible="checklist_type != 'booking'">
                            <i class="fa fa-calendar-check-o" title="Booking check-in"/>
                        </span>
                        <span class="o_cw_tile o_cw_tile_lg o_cw_tile_info" invisible="checklist_type != 'inspection'">
                            <i class="fa fa-search" title="Inspection"/>
                        </span>
                        <span class="o_cw_tile o_cw_tile_lg o_cw_tile_warning" invisible="checklist_type != 'jobcard'">
                            <i class="fa fa-wrench" title="Job card"/>
                        </span>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Vehicle Check-in"/></h1>
                            <div class="o_cw_hero_chips">
                                <span class="o_cw_chip" invisible="not checklist_type_id">
                                    <i class="fa fa-list-ul" title="Used on"/>
                                    <field name="checklist_type_id" readonly="1" nolabel="1" options="{'no_open': True}"/>
                                </span>
                                <span class="o_cw_chip o_cw_chip_success" invisible="not is_default">
                                    <i class="fa fa-magic" title="Applied automatically"/>Applied automatically
                                </span>
                            </div>
                        </div>
                    </div>
                    <group>
                        <group string="Used On" name="used_on">
                            <field name="checklist_type_id" options="{'no_quick_create': True}"/>
                            <field name="checklist_type" invisible="1"/>
                            <field name="inspection_type_id" invisible="checklist_type != 'inspection'"
                                   placeholder="Any inspection" options="{'no_create': True}"/>
                            <field name="vehicle_type_ids" widget="many2many_tags" placeholder="Any vehicle"/>
                        </group>
                        <group string="Options" name="options">
                            <field name="is_default"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="When and by whom is this checklist done?"/>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="item_ids">
                                <list editable="bottom" decoration-bf="is_required">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="is_required" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_carwash_checklist_template_search" model="ir.ui.view">
        <field name="name">carwash.checklist.template.search</field>
        <field name="model">carwash.checklist.template</field>
        <field name="arch" type="xml">
            <search string="Checklist Templates">
                <field name="name"/>
                <field name="checklist_type_id"/>
                <filter string="Applied Automatically" name="is_default" domain="[('is_default', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Used On" name="group_type" context="{'group_by': 'checklist_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Reusable checklist editor embedded in the booking, inspection and lead forms -->
    <record id="view_carwash_checklist_line_list" model="ir.ui.view">
        <field name="name">carwash.checklist.line.list</field>
        <field name="model">carwash.checklist.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="is_done" decoration-bf="is_required and not is_done">
                <field name="sequence" widget="handle"/>
                <field name="is_done" widget="boolean_toggle"/>
                <field name="name"/>
                <!-- saved with the line (readonly fields aren't sent otherwise): it keeps the task mandatory as the template says -->
                <field name="template_item_id" column_invisible="1" force_save="1"/>
                <!-- the checklist template decides what is mandatory - it can't be switched on or off on a booking / inspection -->
                <field name="is_required" widget="boolean_toggle" readonly="1" force_save="1"/>
                <field name="note" optional="show"/>
                <field name="done_by_id" optional="show" widget="many2one_avatar_user"/>
                <field name="done_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_carwash_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">carwash.checklist.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a checklist template</p>
            <p>Checklists guide the work once the vehicle arrives - check-in, pre-wash and
                post-wash inspections, and job cards. Mandatory tasks must be ticked before the next step.</p>
        </field>
    </record>
</odoo>
