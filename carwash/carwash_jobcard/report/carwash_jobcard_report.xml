<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_carwash_jobcard" model="ir.actions.report">
        <field name="name">Job Card</field>
        <field name="model">carwash.jobcard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">carwash_jobcard.report_carwash_jobcard_document</field>
        <field name="report_file">carwash_jobcard.report_carwash_jobcard_document</field>
        <field name="binding_model_id" ref="model_carwash_jobcard"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_carwash_jobcard_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Job Card <span t-field="doc.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Customer:</strong> <span t-field="doc.customer_id.name"/><br/>
                                <strong>Vehicle:</strong> <span t-field="doc.vehicle_id.license_plate"/>
                            </div>
                            <div class="col-6">
                                <strong>Bay:</strong> <span t-field="doc.bay_id.name"/><br/>
                                <strong>Assigned Staff:</strong>
                                <span t-esc="', '.join(doc.assigned_employee_ids.mapped('name'))"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <strong>Start:</strong> <span t-field="doc.start_time"/>
                            </div>
                            <div class="col-6">
                                <strong>End:</strong> <span t-field="doc.end_time"/>
                            </div>
                        </div>
                        <table class="table table-sm o_report_table mt-4">
                            <thead>
                                <tr>
                                    <th>Task</th>
                                    <th class="text-center">Done</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.checklist_line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-center"><span t-field="line.is_check"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-if="doc.qc_notes" class="mt-3">
                            <strong>QC Notes:</strong> <span t-field="doc.qc_notes"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
