<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Car Wash Consumable" on the product (Car Wash tab of the base module) -->
    <record id="view_product_template_form_carwash_consumable" model="ir.ui.view">
        <field name="name">product.template.form.carwash.consumable</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="carwash_base.view_product_template_form_carwash"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_carwash_service']" position="after">
                <field name="is_carwash_consumable" invisible="is_carwash_service"/>
            </xpath>
        </field>
    </record>

    <!-- Consumables with their stock at the current branch -->
    <record id="view_carwash_consumable_list" model="ir.ui.view">
        <field name="name">product.product.list.carwash.consumable</field>
        <field name="model">product.product</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Consumables" editable="bottom" create="false" sample="1">
                <field name="default_code" optional="show" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="categ_id" optional="hide" readonly="1"/>
                <field name="carwash_branch_qty" string="On Hand" decoration-bf="1"
                       decoration-danger="carwash_stock_status == 'out'" decoration-warning="carwash_stock_status == 'low'"/>
                <field name="uom_id" string="Unit" readonly="1" options="{'no_open': True}"/>
                <field name="carwash_min_qty" string="Minimum Stock"/>
                <field name="carwash_stock_status" widget="badge"
                       decoration-success="carwash_stock_status == 'ok'"
                       decoration-warning="carwash_stock_status == 'low'"
                       decoration-danger="carwash_stock_status == 'out'"/>
                <field name="standard_price" string="Cost" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_carwash_consumable_search" model="ir.ui.view">
        <field name="name">product.product.search.carwash.consumable</field>
        <field name="model">product.product</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search string="Consumables">
                <field name="name" string="Consumable" filter_domain="['|', ('name', 'ilike', self), ('default_code', 'ilike', self)]"/>
                <field name="categ_id"/>
                <filter string="Low Stock" name="low" domain="[('carwash_stock_status', '=', 'low')]"/>
                <filter string="Out of Stock" name="out" domain="[('carwash_stock_status', '=', 'out')]"/>
                <filter string="Needs Restock" name="restock" domain="[('carwash_stock_status', 'in', ['low', 'out'])]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="group_categ" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_carwash_consumable_kanban" model="ir.ui.view">
        <field name="name">product.product.kanban.carwash.consumable</field>
        <field name="model">product.product</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <kanban class="o_cw_kanban" sample="1" create="false">
                <field name="carwash_stock_status"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <span t-att-class="{
                            'o_cw_tone_success': record.carwash_stock_status.raw_value === 'ok',
                            'o_cw_tone_warning': record.carwash_stock_status.raw_value === 'low',
                            'o_cw_tone_danger': record.carwash_stock_status.raw_value === 'out'
                        }"/>
                        <aside class="d-flex align-items-start me-3">
                            <field t-if="record.image_128.raw_value" name="image_128" widget="image"
                                   options="{'img_class': 'o_cw_tile object-fit-cover p-0'}" alt="Product"/>
                            <span t-else="" class="o_cw_tile o_cw_tile_info">
                                <i class="fa fa-flask" role="img" aria-label="Consumable" title="Consumable"/>
                            </span>
                        </aside>
                        <main class="flex-grow-1 min-w-0">
                            <div class="o_cw_card_head">
                                <field name="display_name" class="o_cw_card_title"/>
                                <field name="carwash_stock_status" widget="badge" class="small"
                                       decoration-success="carwash_stock_status == 'ok'"
                                       decoration-warning="carwash_stock_status == 'low'"
                                       decoration-danger="carwash_stock_status == 'out'"/>
                            </div>
                            <div class="d-flex align-items-baseline gap-1 mt-1">
                                <field name="carwash_branch_qty" class="o_cw_kpi"/>
                                <field name="uom_id" class="o_cw_kpi_label"/>
                                <span class="o_cw_kpi_label">on hand</span>
                            </div>
                            <footer>
                                <span><i class="fa fa-level-down me-1" title="Minimum stock"/>Min <field name="carwash_min_qty"/></span>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_carwash_consumable_stock" model="ir.actions.act_window">
        <field name="name">Consumable Stock</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,kanban</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_carwash_consumable_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_carwash_consumable_kanban')})]"/>
        <field name="search_view_id" ref="view_carwash_consumable_search"/>
        <field name="domain">[('is_carwash_consumable', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No consumables yet</p>
            <p>Add them under Configuration &gt; Operations &gt; Consumables. Stock shown is the current
                branch's (switch branch top right); set the Minimum Stock right here.</p>
        </field>
    </record>

    <!-- Configuration > Operations > Consumables: set up the products -->
    <record id="action_carwash_consumable_product" model="ir.actions.act_window">
        <field name="name">Consumables</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_carwash_consumable', '=', True)]</field>
        <field name="context">{'default_is_carwash_consumable': True, 'default_type': 'consu', 'default_is_storable': True, 'default_sale_ok': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a consumable</p>
            <p>Shampoo, wax, tyre shine, microfibre cloths... Use them in a service's materials (Car Wash tab of the
                service) and set a minimum stock per branch in Consumables &gt; Stock.</p>
        </field>
    </record>
</odoo>
