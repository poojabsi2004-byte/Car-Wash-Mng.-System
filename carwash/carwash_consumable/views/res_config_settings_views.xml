<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_carwash_consumable" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.carwash.consumable</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="carwash_base.res_config_settings_view_form_carwash"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='carwash_operation_settings']" position="inside">
                <setting id="carwash_consumables" string="Consumable Management"
                         help="Branch stock of consumables, requests (floor issue / wastage / return) with approval, low-stock alerts and consumption analysis.">
                    <field name="group_carwash_consumable"/>
                    <div class="mt8" invisible="not group_carwash_consumable">
                        <button name="%(action_carwash_consumable_product)d" type="action" string="Consumables"
                                icon="oi-arrow-right" class="btn-link"/>
                        <button name="%(action_carwash_consumable_stock)d" type="action" string="Stock &amp; Minimums"
                                icon="oi-arrow-right" class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
