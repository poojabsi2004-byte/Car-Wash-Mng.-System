<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carwash_consumable_request_list" model="ir.ui.view">
        <field name="name">carwash.consumable.request.list</field>
        <field name="model">carwash.consumable.request</field>
        <field name="arch" type="xml">
            <list string="Consumable Requests" sample="1" decoration-muted="state in ('rejected', 'cancel')">
                <field name="name"/>
                <field name="date"/>
                <field name="request_type" widget="badge"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="employee_id" widget="many2one_avatar_employee" optional="hide"/>
                <field name="bay_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="line_count" string="Items"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'"
                       decoration-warning="state == 'approved'" decoration-success="state == 'done'"
                       decoration-danger="state == 'rejected'" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_carwash_consumable_request_kanban" model="ir.ui.view">
        <field name="name">carwash.consumable.request.kanban</field>
        <field name="model">carwash.consumable.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" group_create="false" group_delete="false" records_draggable="false"
                    class="o_cw_kanban" sample="1">
                <field name="state"/>
                <field name="request_type"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <t t-set="tone" t-value="{'draft': 'muted', 'submitted': 'info', 'approved': 'warning', 'done': 'success', 'rejected': 'danger', 'cancel': 'muted'}[record.state.raw_value] or 'muted'"/>
                        <t t-set="type_icon" t-value="{'issue': 'fa-sign-out', 'wastage': 'fa-exclamation-triangle', 'return': 'fa-undo'}[record.request_type.raw_value] or 'fa-cubes'"/>
                        <t t-set="type_tile" t-value="{'wastage': 'o_cw_tile_danger', 'return': 'o_cw_tile_success'}[record.request_type.raw_value] or ''"/>
                        <span t-attf-class="o_cw_tone_{{tone}}"/>
                        <aside class="me-3">
                            <span t-attf-class="o_cw_tile o_cw_tile_sm {{type_tile}}">
                                <i t-attf-class="fa {{type_icon}}" role="img" aria-label="Request type" title="Request type"/>
                            </span>
                        </aside>
                        <main class="flex-grow-1 min-w-0">
                            <div class="o_cw_card_head">
                                <field name="name" class="o_cw_card_title"/>
                                <field name="request_type" widget="badge" class="small"/>
                            </div>
                            <div class="o_cw_card_sub"><field name="date" widget="date"/></div>
                            <div class="o_cw_meta">
                                <div t-if="record.bay_id.raw_value"><i class="fa fa-map-marker" title="Bay"/><field name="bay_id"/></div>
                                <div t-if="record.employee_id.raw_value"><i class="fa fa-user" title="For staff"/><field name="employee_id"/></div>
                                <div groups="base.group_multi_company"><i class="fa fa-building" title="Branch"/><field name="company_id"/></div>
                            </div>
                            <footer>
                                <span><i class="fa fa-cubes me-1" title="Items"/><field name="line_count"/> item(s)</span>
                                <field name="requested_by_id" widget="many2one_avatar_user" class="ms-auto"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_carwash_consumable_request_form" model="ir.ui.view">
        <field name="name">carwash.consumable.request.form</field>
        <field name="model">carwash.consumable.request</field>
        <field name="arch" type="xml">
            <form string="Consumable Request" class="o_cw_form">
                <header>
                    <field name="can_approve" invisible="1"/>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted' or not can_approve"/>
                    <button name="action_issue" type="object" string="Issue Stock" class="btn-primary" icon="fa-cubes"
                            invisible="state != 'approved' or not can_approve"
                            confirm="Move the stock now? This can't be undone (use a Return to Store to bring material back)."/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('submitted', 'approved') or not can_approve"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_carwash_consumption_analysis)d" type="action" class="oe_stat_button" icon="fa-exchange"
                                context="{'search_default_carwash_consumable_request_id': id, 'search_default_done': 0}"
                                invisible="state != 'done'" groups="carwash_base.group_carwash_manager">
                            <div class="o_stat_info"><span class="o_stat_text">Stock Moves</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancel'"/>
                    <div class="alert alert-danger" role="alert" invisible="state != 'rejected'">
                        <strong>Rejected:</strong> <field name="reject_reason" readonly="1" class="d-inline"/>
                    </div>
                    <div class="o_cw_hero">
                        <span class="o_cw_tile o_cw_tile_lg" invisible="request_type != 'issue'"><i class="fa fa-sign-out" title="Floor issue"/></span>
                        <span class="o_cw_tile o_cw_tile_lg o_cw_tile_danger" invisible="request_type != 'wastage'"><i class="fa fa-exclamation-triangle" title="Wastage / damage"/></span>
                        <span class="o_cw_tile o_cw_tile_lg o_cw_tile_success" invisible="request_type != 'return'"><i class="fa fa-undo" title="Return to store"/></span>
                        <div class="oe_title">
                            <label for="name" string="Consumable Request"/>
                            <h1><field name="name" readonly="1"/></h1>
                            <div class="o_cw_hero_chips">
                                <span class="o_cw_chip"><i class="fa fa-tag" title="Type"/><field name="request_type" readonly="1" nolabel="1"/></span>
                                <span class="o_cw_chip o_cw_chip_info" invisible="not bay_id"><i class="fa fa-map-marker" title="Bay"/><field name="bay_id" readonly="1" nolabel="1" options="{'no_open': True}"/></span>
                                <span class="o_cw_chip o_cw_chip_muted" groups="base.group_multi_company"><i class="fa fa-building" title="Branch"/><field name="company_id" readonly="1" nolabel="1" options="{'no_open': True}"/></span>
                            </div>
                        </div>
                        <div class="o_cw_hero_kpis">
                            <div class="o_cw_hero_kpi">
                                <field name="line_count" class="o_cw_hero_kpi_value"/>
                                <span class="o_cw_hero_kpi_label">Items</span>
                            </div>
                        </div>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="request_type" widget="radio" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="requested_by_id" readonly="1" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Where">
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="bay_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="employee_id" widget="many2one_avatar_employee" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group invisible="not approved_by_id and not issued_by_id and not issue_date">
                        <group string="Approval">
                            <field name="approved_by_id" invisible="not approved_by_id" widget="many2one_avatar_user"/>
                            <field name="issued_by_id" invisible="not issued_by_id" widget="many2one_avatar_user"/>
                            <field name="issue_date" invisible="not issue_date"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1" colspan="2"
                               placeholder="Why is it needed? For wastage: what happened (spilled, expired, damaged...)"
                               readonly="state != 'draft'" required="request_type == 'wastage'"/>
                    </group>
                    <notebook>
                        <page string="Consumables" name="consumables">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" options="{'no_create': True}" groups="uom.group_uom"/>
                                    <field name="available_qty" string="In Stock (Branch)"
                                           decoration-danger="parent.request_type != 'return' and available_qty &lt; quantity"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_carwash_consumable_request_search" model="ir.ui.view">
        <field name="name">carwash.consumable.request.search</field>
        <field name="model">carwash.consumable.request</field>
        <field name="arch" type="xml">
            <search string="Consumable Requests">
                <field name="name"/>
                <field name="line_ids" string="Consumable" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <field name="requested_by_id"/>
                <field name="bay_id"/>
                <filter string="My Requests" name="mine" domain="[('requested_by_id', '=', uid)]"/>
                <separator/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'submitted')]"/>
                <filter string="To Issue" name="to_issue" domain="[('state', '=', 'approved')]"/>
                <filter string="Issued" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Floor Issue" name="issue" domain="[('request_type', '=', 'issue')]"/>
                <filter string="Wastage" name="wastage" domain="[('request_type', '=', 'wastage')]"/>
                <filter string="Return" name="return" domain="[('request_type', '=', 'return')]"/>
                <separator/>
                <filter string="Date" name="date" date="date"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'request_type'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_carwash_consumable_request" model="ir.actions.act_window">
        <field name="name">Consumable Requests</field>
        <field name="res_model">carwash.consumable.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Request consumables</p>
            <p>Need extra shampoo for a bay, spilled a can of wax, bringing back unused cloths? Create a request:
                Draft &gt; Submit &gt; the manager Approves &gt; Issue Stock moves it in the branch store.</p>
        </field>
    </record>

    <record id="view_carwash_consumable_request_reject_form" model="ir.ui.view">
        <field name="name">carwash.consumable.request.reject.form</field>
        <field name="model">carwash.consumable.request.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Request">
                <field name="request_ids" invisible="1"/>
                <field name="reason" placeholder="Why is it rejected?"/>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
