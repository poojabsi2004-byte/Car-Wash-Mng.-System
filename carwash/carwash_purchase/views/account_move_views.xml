<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchases > Vendor Bills -->
    <record id="action_carwash_vendor_bill" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund'))]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'display_account_trust': True}</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_in_invoice_bill_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No vendor bill yet</p>
            <p>Create the bill from the purchase order (Create Bill) once the goods are received: only received
                quantities are billed, with their GST. Confirm it, then Pay.</p>
        </field>
    </record>

    <!-- Purchases > Supplier Dues: posted bills still to pay -->
    <record id="action_carwash_supplier_due" model="ir.actions.act_window">
        <field name="name">Vendor Dues</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'group_by': 'partner_id', 'create': False}</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_in_invoice_bill_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing due</p>
            <p>Confirmed vendor bills not fully paid yet, per supplier.</p>
        </field>
    </record>
</odoo>
