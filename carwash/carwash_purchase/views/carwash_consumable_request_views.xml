<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carwash_consumable_request_form_purchase" model="ir.ui.view">
        <field name="name">carwash.consumable.request.form.purchase</field>
        <field name="model">carwash.consumable.request</field>
        <field name="inherit_id" ref="carwash_consumable.view_carwash_consumable_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reject']" position="before">
                <button name="action_carwash_request_purchase" type="object" string="Request Purchase" icon="fa-shopping-cart"
                        invisible="state not in ('submitted', 'approved') or request_type != 'issue'"
                        groups="purchase.group_purchase_user"
                        help="Order what the branch is missing to issue this request from the preferred suppliers."/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_carwash_view_purchases" type="object" class="oe_stat_button" icon="fa-shopping-cart"
                        invisible="not carwash_purchase_count" groups="purchase.group_purchase_user">
                    <field name="carwash_purchase_count" widget="statinfo" string="Purchases"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
